#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  network:
    network:
      version: 2
      ethernets:
        eth0:
          dhcp4: true
          dhcp-identifier: mac

  storage:
    layout:
      name: direct
      match:
        size: largest

  identity:
    hostname: crate
    realname: Crate
    username: crate
    # Password: CrateTemp1!  (overwritten and locked by 99-cleanup.sh)
    password: "$6$saltsaltsaltsalt$wnENxg31R2KDmONTGuNb/IT3P8IMw64OFO4cRAg7VojQPDqR6OY1B/T84oGnBZcpmYuAl4kzLlFLYPXU1XvhO1"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []

  packages:
    - curl
    - git
    - jq
    - apt-transport-https
    - ca-certificates
    - gnupg
    - open-vm-tools        # VMware guest agent
    - qemu-guest-agent     # QEMU/KVM guest agent
    - avahi-daemon         # mDNS — crate.local
    - libnss-mdns          # NSS resolver for .local
    - nfs-common
    - chrony               # NTP

  late-commands:
    # Passwordless sudo for build-time provisioning (locked in cleanup script)
    - echo 'crate ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/crate-nopasswd
    - chmod 440 /target/etc/sudoers.d/crate-nopasswd

    # Ensure SSH password auth survives first boot.
    # 50-cloud-init.conf sets PasswordAuthentication no — delete it and replace
    # with a higher-priority file. Also patch sshd_config itself as a backstop.
    - rm -f /target/etc/ssh/sshd_config.d/50-cloud-init.conf
    - mkdir -p /target/etc/ssh/sshd_config.d
    - echo 'PasswordAuthentication yes' > /target/etc/ssh/sshd_config.d/60-packer.conf
    - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /target/etc/ssh/sshd_config

    # Disable cloud-init on first boot (prevents it re-writing SSH config)
    - touch /target/etc/cloud/cloud-init.disabled

  user-data:
    disable_root: true

  updates: security

  # Skip the interactive installer prompts
  interactive-sections: []
