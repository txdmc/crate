#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  network:
    network:
      version: 2
      ethernets:
        eth0:
          dhcp4: true
          dhcp-identifier: mac

  storage:
    layout:
      name: direct
      match:
        size: largest

  identity:
    hostname: pelico
    realname: Pelico
    username: pelico
    # Password: PelicoTemp1!  (overwritten and locked by 99-cleanup.sh)
    password: "$6$rounds=4096$saltsaltsaltsalt$lJNRc.gsJi3M7cYuWMIGPfbOBqmI7BxfPy7LmGBE4L2YHHy3dSJ5.5lDwgcbP7Ql1hoCQQnxQfQb5PdQi.IG0"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []

  packages:
    - curl
    - git
    - jq
    - apt-transport-https
    - ca-certificates
    - gnupg
    - open-vm-tools        # VMware guest agent
    - qemu-guest-agent     # QEMU/KVM guest agent
    - avahi-daemon         # mDNS — pelico.local
    - libnss-mdns          # NSS resolver for .local
    - nfs-common
    - chrony               # NTP

  late-commands:
    # Passwordless sudo for build-time provisioning (locked in cleanup script)
    - echo 'pelico ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/pelico-nopasswd
    - chmod 440 /target/etc/sudoers.d/pelico-nopasswd

    # Make sure SSH password auth is on (Packer needs it during build)
    - sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /target/etc/ssh/sshd_config
    - sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /target/etc/ssh/sshd_config

    # Disable cloud-init after install (we don't want it on subsequent boots)
    - touch /target/etc/cloud/cloud-init.disabled

  user-data:
    disable_root: true

  updates: security

  # Skip the interactive installer prompts
  interactive-sections: []
